{
  "name": "gha-security-scanner",
  "description": "Generates and uploads SARIF files to GitHub Advanced Security",
  "version": "0.0.1",
  "author": "Workiva",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/Workiva/gha-security-scanner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Workiva/gha-security-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/Workiva/gha-security-scanner/issues"
  },
  "keywords": [
    "github",
    "actions",
    "codeql",
    "sarif"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "bundle": "pnpm run format && pnpm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "format": "prettier --write .",
    "lint": "eslint .",
    "local-action": "pnpx @github/local-action . src/main.ts .env",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "pnpm run package -- --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "all": "pnpm run format && pnpm run lint && pnpm run test && pnpm run package"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@eslint/compat": "^2.0.5",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@jest/globals": "^30.3.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.7.0",
    "jest": "^30.3.0",
    "js-yaml": "^4.2.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.8.3",
    "prettier-eslint": "^16.4.2",
    "rollup": "^4.60.2",
    "ts-jest": "^29.4.9",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
